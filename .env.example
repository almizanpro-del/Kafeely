# ============================================================================
# CLIENT (build-time) VARIABLES
# No client-side variables are required to build or run this site today.
#
# The production origin (used for the absolute og:image / twitter:image /
# og:url tags) is NOT an env var: it is the SITE_URL constant in
# src/config/site.ts. Change it there — in one place only.
#
# If you later add public build-time values, use the VITE_ prefix and
# reference them in code via import.meta.env.VITE_*.
#
# Super-Admin console access: open https://<domain>/#super-admin and register.
# Only the FIRST account can bootstrap as Super-Admin, and only while
# ADMIN_BOOTSTRAP_TOKEN is set and valid. Remove that token immediately after
# the first registration — later registrations are pending staff accounts.
# ============================================================================

# ============================================================================
# SERVER-SIDE SECRETS — Vercel Functions only (docs/backend-migration.md).
# Set these in the Vercel dashboard (Project → Settings → Environment
# Variables). NEVER prefix them with VITE_ and NEVER put real values here —
# this file documents names and shapes only.
# ============================================================================

# Neon Postgres POOLED connection string (ends with -pooler.<region>.aws.neon.tech)
# Get it from the Neon dashboard after creating the project (Phase 0).
DATABASE_URL=

# HMAC key for session/email tokens. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# One-time Super-Admin bootstrap token. It is only honoured for the very first
# account ever created; that account is verified immediately. REMOVE it from
# the environment after the first registration (launch checklist §10).
ADMIN_BOOTSTRAP_TOKEN=

# Canonical public origin used for links inside transactional emails
# (verification, reset, waitlist double opt-in). Never derived from request
# headers. Set per environment for preview deploys; defaults to
# https://kafeely.com. Must be HTTPS in production.
SITE_URL=https://kafeely.com

# Shared secret for the daily housekeeping cron (/api/cron/purge), which
# hard-deletes records past their 30-day erasure window and prunes expired
# sessions/tokens. Generate like SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Resend API key for transactional email (verification, password reset).
# https://resend.com — verify SPF/DKIM/DMARC for the sending domain first.
RESEND_API_KEY=

# Sender identity for backend emails (optional; this is the default).
EMAIL_FROM=Kafeely <noreply@kafeely.com>

# ONLY for exotic local http testing (cookies without Secure). Leave unset
# in production — the __Host- session cookie must always be Secure.
# COOKIE_INSECURE=1
