// Kafeely — Dubai Premium Rental Protection Platform
// Multi-role dashboard data model.
//
// DATABASE: Neon Postgres (production).
// Statuses are plain String columns validated at the application layer
// (see src/lib/types.ts) so the schema stays portable. To seed a fresh
// Neon database run:  bunx prisma db push && bun prisma/seed.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity ─────────────────────────────

/// Roles: super_admin | landlord | tenant | broker | agent | facility | leasing
/// Status: active | pending | suspended
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  fullName     String
  phone        String?
  role         String
  status       String       @default("active")
  locale       String       @default("en")
  jobTitle     String?
  organization String?
  agencyId     String?
  avatarSeed   String       @default("K")
  createdAt    DateTime     @default(now())
  lastLoginAt  DateTime?
  agency       Agency?      @relation(fields: [agencyId], references: [id])
  notifications Notification[]
  targets      Target[]
  leads        Lead[]       @relation("LeadOwner")
  audits       AuditLog[]   @relation("AuditActor")
  ownedUnits   Unit[]       @relation("UnitLandlord")
  tenantLeases Lease[]      @relation("LeaseTenant")
  landlordLeases Lease[]    @relation("LeaseLandlord")
  claimsRaised Claim[]      @relation("ClaimRaiser")
}

/// Invite status: pending | accepted | expired
model Invite {
  id         String    @id @default(cuid())
  email      String
  role       String // tenant | broker | landlord
  ownerId    String
  ownerName  String
  status     String    @default("pending")
  sentAt     DateTime  @default(now())
  acceptedAt DateTime?
}

model Agency {
  id           String  @id @default(cuid())
  name         String
  licenseNo    String?
  targetDeals  Int     @default(0)
  achievedDeals Int    @default(0)
  users        User[]
}

/// Waitlist & leads pipeline (marketing site conversions)
/// audience: owner | tenant | partner | investor
/// status: new | contacted | qualified | converted | erased
model WaitlistEntry {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  audience  String
  source    String    @default("website")
  status    String    @default("new")
  notes     String?
  createdAt DateTime  @default(now())
}

// ───────────────────────────── Portfolio ─────────────────────────────

/// type: building | community | tower
model Property {
  id               String  @id @default(cuid())
  name             String
  nameAr           String?
  district         String
  districtAr       String?
  address          String
  type             String  @default("building")
  totalFloors      Int     @default(1)
  yearBuilt        Int?
  amenities        String? // comma separated
  facilityManagerId String? // User with role=facility
  units            Unit[]
  tickets          Ticket[]
  inspections      Inspection[]
  announcements    Announcement[]
}

/// Unit status: occupied | vacant | under_notice | maintenance
/// Protection: protected | pending | unprotected
model Unit {
  id               String   @id @default(cuid())
  code             String   @unique // e.g. MG1-1204
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id])
  floor            Int
  type             String   // studio | 1br | 2br | 3br | 4br | penthouse | villa
  bedrooms         Int
  bathrooms        Int
  sizeSqm          Int
  rentAed          Int
  status           String   @default("vacant")
  protectionStatus String   @default("unprotected")
  view             String?
  landlordId       String?
  landlord         User?    @relation("UnitLandlord", fields: [landlordId], references: [id])
  leases           Lease[]
  claims           Claim[]
  tickets          Ticket[]
  inspections      Inspection[]
  documents        Document[]
  applications     Application[]
  viewings         Viewing[]
  offers           Offer[]
  createdAt        DateTime @default(now())
}

/// Lease status: active | expiring_soon | upcoming | terminated
/// paymentFrequency: 1 | 2 | 4 | 12 (cheques per year)
model Lease {
  id               String    @id @default(cuid())
  ref              String    @unique // LSE-2026-0142
  unitId           String
  unit             Unit      @relation(fields: [unitId], references: [id])
  tenantId         String
  tenant           User      @relation("LeaseTenant", fields: [tenantId], references: [id])
  landlordId       String
  landlord         User      @relation("LeaseLandlord", fields: [landlordId], references: [id])
  startDate        DateTime
  endDate          DateTime
  rentAed          Int
  paymentFrequency Int       @default(4)
  status           String    @default("active")
  ejariNumber      String?
  protectionEnrolled Boolean @default(false)
  claims           Claim[]
  payments         Payment[]
  documents        Document[]
  createdAt        DateTime  @default(now())
}

// ───────────────────────────── Protection & Ops ─────────────────────────────

/// Claim type: rent_default | damage | legal | early_termination | maintenance
/// Status: submitted | under_review | approved | rejected | settled
/// Priority: low | medium | high | urgent
model Claim {
  id          String    @id @default(cuid())
  ref         String    @unique // CLM-2026-0031
  leaseId     String?
  lease       Lease?    @relation(fields: [leaseId], references: [id])
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id])
  raisedById  String
  raisedBy    User      @relation("ClaimRaiser", fields: [raisedById], references: [id])
  type        String
  status      String    @default("submitted")
  amountAed   Int
  priority    String    @default("medium")
  description String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

/// Ticket category: plumbing | electrical | hvac | cleaning | security | other
/// Status: open | in_progress | resolved | closed
model Ticket {
  id               String    @id @default(cuid())
  ref              String    @unique // TKT-2026-0117
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id])
  unitId           String?
  unit             Unit?     @relation(fields: [unitId], references: [id])
  raisedById       String?
  assignedVendorId String?
  vendor           Vendor?   @relation(fields: [assignedVendorId], references: [id])
  category         String
  priority         String    @default("medium")
  status           String    @default("open")
  title            String
  description      String?
  scheduledFor     DateTime?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  category      String
  contactName   String?
  phone         String?
  rating        Float    @default(4.5)
  jobsCompleted Int      @default(0)
  status        String   @default("active")
  tickets       Ticket[]
}

/// Inspection type: move_in | move_out | routine | compliance
/// Status: scheduled | completed | overdue
model Inspection {
  id              String    @id @default(cuid())
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id])
  unitId          String?
  unit            Unit?     @relation(fields: [unitId], references: [id])
  type            String
  scheduledFor    DateTime
  status          String    @default("scheduled")
  inspector       String?
  findings        String?
  complianceScore Int?
}

/// Document category: lease | addendum | certificate | invoice | statement | compliance | other
/// Status: verified | pending | expired
model Document {
  id         String   @id @default(cuid())
  name       String
  category   String
  ownerRole  String
  ownerId    String
  unitId     String?
  unit       Unit?    @relation(fields: [unitId], references: [id])
  leaseId    String?
  lease      Lease?   @relation(fields: [leaseId], references: [id])
  sizeKb     Int      @default(240)
  status     String   @default("verified")
  uploadedAt DateTime @default(now())
}

/// Payment status: paid | pending | overdue | upcoming
/// method: cheque | bank_transfer | card
model Payment {
  id            String    @id @default(cuid())
  leaseId       String
  lease         Lease     @relation(fields: [leaseId], references: [id])
  installmentNo Int
  amountAed     Int
  dueDate       DateTime
  paidDate      DateTime?
  method        String    @default("cheque")
  status        String    @default("upcoming")
}

// ───────────────────────────── Brokerage & Leasing ─────────────────────────────

/// Lead stage: new | contacted | viewing | offer | negotiation | won | lost
/// clientType: landlord | tenant | investor
model Lead {
  id               String   @id @default(cuid())
  clientName       String
  clientType       String
  phone            String?
  email            String?
  stage            String   @default("new")
  interest         String?
  budgetAed        Int?
  estCommissionAed Int      @default(0)
  ownerId          String
  owner            User     @relation("LeadOwner", fields: [ownerId], references: [id])
  propertyId       String?
  source           String   @default("website")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Commission status: pending | approved | paid
model Commission {
  id         String    @id @default(cuid())
  ownerId    String
  dealRef    String
  clientName String
  amountAed  Int
  ratePct    Float
  status     String    @default("pending")
  closedAt   DateTime?
  paidAt     DateTime?
}

/// Application status: new | screening | approved | rejected
model Application {
  id               String   @id @default(cuid())
  ref              String   @unique
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id])
  applicantName    String
  phone            String?
  email            String?
  nationality      String?
  monthlyIncomeAed Int?
  score            Int?
  status           String   @default("new")
  submittedAt      DateTime @default(now())
}

model Viewing {
  id          String    @id @default(cuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id])
  leadName    String
  phone       String?
  agentName   String?
  scheduledAt DateTime
  status      String    @default("scheduled") // scheduled | completed | no_show | cancelled
}

/// Offer fromType: tenant | landlord
/// status: pending | countered | accepted | declined
model Offer {
  id       String   @id @default(cuid())
  unitId   String
  unit     Unit     @relation(fields: [unitId], references: [id])
  fromType String
  fromName String
  amountAed Int
  terms    String?
  status   String   @default("pending")
  createdAt DateTime @default(now())
}

/// audience: tenants | owners | all
model Announcement {
  id         String   @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])
  title      String
  body       String
  audience   String   @default("all")
  priority   String   @default("normal") // normal | important | urgent
  sentById   String?
  sentAt     DateTime @default(now())
}

// ───────────────────────────── Platform ─────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorName  String
  actorRole  String
  action     String
  entityType String
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  titleEn   String
  titleAr   String
  bodyEn    String
  bodyAr    String
  type      String   @default("system") // claim | ticket | lease | payment | system | lead
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Target {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  period String // e.g. 2026-Q4
  metric String // deals | listings | revenue
  target Int
  actual Int    @default(0)
}
